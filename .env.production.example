# Copy this to .env.production (gitignored) and fill in real values.
#
# This file is loaded ONLY by the `:prod` npm scripts (migrate:prod, seed:prod, seed:runways:prod,
# db:backup:prod, db:reconcile:prod, db:copy-local:prod — all run with `-w server`), each of which prints
# a "PRODUCTION TURSO" warning naming the database URL before doing anything. Every plain script (migrate,
# seed, seed:runways, db:backup, npm run dev, npm test, ...) never reads this file and always runs
# against your local SQLite file — production can't be touched by accident.
#
# See docs/DEPLOY.md for where to get these from the Turso dashboard.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token
