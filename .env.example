# Copy to .env (git-ignored) to run the db:* scripts against your Turso database.
# The local dev server ignores this file, so `npm run dev` never touches Turso.

# From the Turso dashboard: database URL (libsql://...) and a database token.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Only needed on Vercel (Project Settings > Environment Variables), not here:
# APP_PASSCODE=a-long-passphrase-only-you-know
